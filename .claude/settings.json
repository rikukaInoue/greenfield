{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Write",
      "Edit",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(git push origin *)",
      "Bash(git fetch *)",
      "Bash(git pull --ff-only *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh run *)",
      "Bash(gh api *)",
      "Bash(docker compose *)",
      "Bash(docker logs *)",
      "Bash(docker exec *)",
      "Bash(docker ps *)",
      "Bash(mise run *)",
      "Bash(go test *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(npm run test *)",
      "Bash(npm run lint *)",
      "Bash(npx tsc *)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Bash(rtk *)",
      "Bash(curl -s http://localhost*)",
      "Bash(curl -s http://127.0.0.1*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(wget *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Write(.env*)",
      "Write(*.pem)",
      "Write(*.key)",
      "Read(.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/inouetaishi/gh/claude-harness/hooks/protect-bash.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/inouetaishi/gh/claude-harness/hooks/file-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/inouetaishi/gh/claude-harness/hooks/post-edit-feedback.sh"
          },
          {
            "type": "command",
            "command": "/Users/inouetaishi/gh/claude-harness/hooks/post-edit-diffsize.sh"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/inouetaishi/gh/claude-harness/hooks/post-compact.sh"
          }
        ]
      }
    ]
  }
}