{
  "components": {
    "schemas": {
      "AdminDeleteAccountOutputBody": {
        "additionalProperties": false,
        "properties": {
          "deleted_photos": {
            "description": "削除した写真の件数",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "deleted_photos"
        ],
        "type": "object"
      },
      "AdminListPhotosOutputBody": {
        "additionalProperties": false,
        "properties": {
          "photos": {
            "description": "写真の一覧",
            "items": {
              "$ref": "#/components/schemas/AdminPhoto"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "photos"
        ],
        "type": "object"
      },
      "AdminPhoto": {
        "additionalProperties": false,
        "properties": {
          "caption": {
            "description": "キャプション",
            "type": "string"
          },
          "created_at": {
            "description": "投稿時刻",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "写真ID",
            "examples": [
              1
            ],
            "format": "int64",
            "type": "integer"
          },
          "owner_id": {
            "description": "投稿者のSubject",
            "examples": [
              "u_01H..."
            ],
            "type": "string"
          },
          "status": {
            "description": "画像のアップロード状態",
            "enum": [
              "pending_upload",
              "ready"
            ],
            "type": "string"
          },
          "visibility": {
            "description": "公開状態",
            "enum": [
              "private",
              "public"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "owner_id",
          "caption",
          "visibility",
          "status",
          "created_at"
        ],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "機械可読のエラーコード",
            "examples": [
              "photo.not_found"
            ],
            "type": "string"
          },
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "description": "photo サービスの管理API（社内オペレータ）。",
    "title": "photo admin API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/accounts/{subject}:delete": {
      "post": {
        "description": "ステップアップ（RFC 9470）の検証対象。AAL2 を要求する呼び出し語彙を固定してある。",
        "operationId": "AdminDeleteAccount",
        "parameters": [
          {
            "description": "削除対象のSubject",
            "in": "path",
            "name": "subject",
            "required": true,
            "schema": {
              "description": "削除対象のSubject",
              "maxLength": 255,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminDeleteAccountOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "アカウントと全投稿を削除する（危険操作）",
        "tags": [
          "accounts"
        ]
      }
    },
    "/photos": {
      "get": {
        "description": "platform operator の権限で列挙する。",
        "operationId": "AdminListPhotos",
        "parameters": [
          {
            "description": "投稿者のSubjectで絞る",
            "explode": false,
            "in": "query",
            "name": "owner_id",
            "schema": {
              "description": "投稿者のSubjectで絞る",
              "type": "string"
            }
          },
          {
            "description": "取得件数",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "description": "取得件数",
              "format": "int64",
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminListPhotosOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "全ユーザーの写真一覧（オペレータ）",
        "tags": [
          "photos"
        ]
      }
    }
  }
}
